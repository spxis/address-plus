{
  "$schema": "../../schemas/test-file.json",
  "name": "US Intersection Addresses",
  "description": "US street intersection parsing test cases with various intersection delimiters (& and) and street type combinations",
  "tests": {
    "intersections": [
      {
        "input": "Larch & Bellamy Baton Rouge LA",
        "expected": {
          "city": "Baton Rouge",
          "state": "LA",
          "street1": "Larch",
          "type1": "",
          "street2": "Bellamy",
          "type2": ""
        },
        "description": "Basic intersection with ampersand separator"
      },
      {
        "input": "Larch & Bellamy, Baton Rouge LA",
        "expected": {
          "city": "Baton Rouge",
          "state": "LA",
          "street1": "Larch",
          "type1": "",
          "street2": "Bellamy",
          "type2": ""
        },
        "description": "Intersection with ampersand and comma before city"
      },
      {
        "input": "Larch St and Bellamy St Baton Rouge LA",
        "expected": {
          "city": "Baton Rouge",
          "state": "LA",
          "street1": "Larch",
          "type1": "St",
          "street2": "Bellamy",
          "type2": "St"
        },
        "description": "Intersection with 'and' connector and city location"
      },
      {
        "input": "Larch St and Bellamy St",
        "expected": {
          "street1": "Larch",
          "type1": "St",
          "street2": "Bellamy",
          "type2": "St"
        },
        "description": "Intersection with 'and' connector - no location"
      },
      {
        "input": "Larch St & Bellamy St Baton Rouge LA",
        "expected": {
          "city": "Baton Rouge",
          "state": "LA",
          "street1": "Larch",
          "type1": "St",
          "street2": "Bellamy",
          "type2": "St"
        },
        "description": "Intersection with individual street types"
      },
      {
        "input": "Larch and Bellamy Sts Baton Rouge LA",
        "expected": {
          "city": "Baton Rouge",
          "state": "LA",
          "street1": "Larch",
          "type1": "",
          "street2": "Bellamy",
          "type2": "Sts"
        },
        "description": "Intersection with plural 'Sts' for second street"
      },
      {
        "input": "Larch & Bellamy Sts. Baton Rouge LA",
        "expected": {
          "city": "Baton Rouge",
          "state": "LA",
          "street1": "Larch",
          "type1": "",
          "street2": "Bellamy",
          "type2": "Sts"
        },
        "description": "Intersection with abbreviated 'Sts.' and period"
      },
      {
        "input": "Larch and Bellamy Sts.",
        "expected": {
          "street1": "Larch",
          "type1": "",
          "street2": "Bellamy",
          "type2": "Sts"
        },
        "description": "Intersection without location - 'and' connector with period"
      },
      {
        "input": "Larch & Bellamy Streets Baton Rouge LA",
        "expected": {
          "city": "Baton Rouge",
          "state": "LA",
          "street1": "Larch",
          "type1": "",
          "street2": "Bellamy",
          "type2": "Sts"
        },
        "description": "Intersection with full word 'Streets'"
      },
      {
        "input": "Larch Avenue and Bellamy Street Baton Rouge LA",
        "expected": {
          "city": "Baton Rouge",
          "state": "LA",
          "street1": "Larch",
          "type1": "Ave",
          "street2": "Bellamy",
          "type2": "St"
        },
        "description": "Intersection with different street types for each street"
      },
      {
        "input": "Main St and Oak Ave, Springfield, IL",
        "expected": {
          "city": "Springfield",
          "state": "IL",
          "street1": "Main",
          "type1": "St",
          "street2": "Oak",
          "type2": "Ave"
        },
        "description": "Generic intersection in Springfield with comma separators"
      },
      {
        "input": "N Main St & E Oak Ave",
        "expected": {
          "prefix1": "N",
          "street1": "Main",
          "type1": "St",
          "prefix2": "E",
          "street2": "Oak",
          "type2": "Ave"
        },
        "description": "Intersection with directional prefixes for both streets"
      },
      {
        "input": "Broadway @ 42nd St, New York, NY",
        "expected": {
          "city": "New York",
          "state": "NY",
          "street1": "Broadway",
          "type1": "",
          "street2": "42nd",
          "type2": "St"
        },
        "description": "Intersection using '@' symbol as separator"
      }
    ],
    "oneWordCity": [
      {
        "input": "Main St and Pine St Tacoma WA",
        "expected": {
          "city": "Tacoma",
          "state": "WA",
          "street1": "Main",
          "type1": "St",
          "street2": "Pine",
          "type2": "St"
        },
        "description": "One-word city after a typed second street, no commas: the type ends the street"
      },
      {
        "input": "1st Ave and Pine St Seattle WA 98101",
        "expected": {
          "city": "Seattle",
          "state": "WA",
          "zip": "98101",
          "street1": "1st",
          "type1": "Ave",
          "street2": "Pine",
          "type2": "St"
        },
        "description": "One-word city with a ZIP after it"
      },
      {
        "input": "Main St & Pine Ave Tacoma WA 98402",
        "expected": {
          "city": "Tacoma",
          "state": "WA",
          "zip": "98402",
          "street1": "Main",
          "type1": "St",
          "street2": "Pine",
          "type2": "Ave"
        },
        "description": "One-word city, ampersand and an avenue"
      },
      {
        "input": "Main and Pine Sts Tacoma WA",
        "expected": {
          "city": "Tacoma",
          "state": "WA",
          "street1": "Main",
          "type1": "",
          "street2": "Pine",
          "type2": "Sts"
        },
        "description": "One-word city after a shared plural type"
      },
      {
        "input": "Main St and Pine St Salt Lake City UT",
        "expected": {
          "city": "Salt Lake City",
          "state": "UT",
          "street1": "Main",
          "type1": "St",
          "street2": "Pine",
          "type2": "St"
        },
        "description": "Three-word city with a street-type word (Lake) inside it"
      },
      {
        "input": "N Main St & E Oak Ave Boise ID",
        "expected": {
          "city": "Boise",
          "state": "ID",
          "prefix1": "N",
          "street1": "Main",
          "type1": "St",
          "prefix2": "E",
          "street2": "Oak",
          "type2": "Ave"
        },
        "description": "One-word city after directional prefixes on both streets"
      },
      {
        "input": "5th Ave and 42nd St New York NY",
        "expected": {
          "city": "New York",
          "state": "NY",
          "street1": "5th",
          "type1": "Ave",
          "street2": "42nd",
          "type2": "St"
        },
        "description": "Ordinal streets, two-word city, no commas"
      }
    ]
  }
}
